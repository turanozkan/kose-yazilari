---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const latestPost = posts[0];
const otherPosts = posts.slice(1);

function getImageUrl(image) {
	if (!image) return '';
	return typeof image === 'object' && image.src ? image.src : image;
}
---

<!doctype html>
<html lang="tr">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			{latestPost && (
				<section class="lead-article">
					<div class="lead-wrapper">
						<div class="lead-image-box">
							<a href={`/blog/${latestPost.id}/`}>
								<img 
									src={getImageUrl(latestPost.data.heroImage)} 
									alt={latestPost.data.title} 
								/>
							</a>
						</div>
						<div class="lead-content">
							<div class="lead-tag">
								<span>Son Yazı</span>
								<FormattedDate date={latestPost.data.pubDate} />
							</div>
							<h1 class="lead-title">
								<a href={`/blog/${latestPost.id}/`}>
									{latestPost.data.title}
								</a>
							</h1>
							<p class="lead-description">
								{latestPost.data.description}
							</p>
							<a href={`/blog/${latestPost.id}/`} class="read-btn">
								Yazıyı Oku <span>&rarr;</span>
							</a>
						</div>
					</div>
				</section>
			)}

			<section class="posts-section">
				<div class="section-header">
					<h2>Önceki Köşe Yazıları</h2>
					<a href="/blog" class="all-archive-link">Tüm Arşiv &rarr;</a>
				</div>
				<ul class="posts-grid">
					{
						otherPosts.map((post) => (
							<li class="post-card">
								<a href={`/blog/${post.id}/`} class="card-link">
									<div class="card-img-wrap">
										<img 
											src={getImageUrl(post.data.heroImage)} 
											alt={post.data.title} 
										/>
									</div>
									<div class="card-body">
										<div class="card-date">
											<FormattedDate date={post.data.pubDate} />
										</div>
										<h3 class="card-title">{post.data.title}</h3>
										<p class="card-desc">{post.data.description}</p>
									</div>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		max-width: 1040px;
		width: 100%;
		margin: 0 auto;
		padding: 2.5rem 1.25rem 4rem 1.25rem;
		box-sizing: border-box;
	}

	.lead-article {
		background: #ffffff;
		border-radius: 12px;
		border: 1px solid #eaeaea;
		overflow: hidden;
		margin-bottom: 3.5rem;
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
		width: 100%;
		box-sizing: border-box;
	}
	.lead-wrapper {
		display: grid;
		grid-template-columns: 1.15fr 1fr;
		align-items: center;
		width: 100%;
	}
	.lead-image-box {
		width: 100%;
		height: 100%;
		min-height: 350px;
		background: #f4f4f4;
	}
	.lead-image-box a {
		display: block;
		width: 100%;
		height: 100%;
	}
	.lead-image-box img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}
	.lead-content {
		padding: 2.5rem 2.2rem;
		box-sizing: border-box;
	}
	.lead-tag {
		display: flex;
		align-items: center;
		gap: 0.8rem;
		font-size: 0.85rem;
		color: #71717a;
		margin-bottom: 0.9rem;
		font-weight: 500;
	}
	.lead-tag span {
		background: #18181b;
		color: #ffffff;
		padding: 0.2rem 0.55rem;
		border-radius: 4px;
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.03em;
		text-transform: uppercase;
	}
	.lead-title {
		font-size: 1.85rem;
		line-height: 1.3;
		margin: 0 0 1rem 0;
		font-weight: 700;
		letter-spacing: -0.02em;
		word-break: break-word;
	}
	.lead-title a {
		color: #09090b;
		text-decoration: none;
	}
	.lead-description {
		font-size: 1rem;
		line-height: 1.6;
		color: #52525b;
		margin-bottom: 1.6rem;
	}
	.read-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-weight: 600;
		font-size: 0.95rem;
		color: #09090b;
		text-decoration: none;
		border-bottom: 2px solid #09090b;
		padding-bottom: 2px;
	}

	.posts-section {
		margin-top: 1rem;
		width: 100%;
	}
	.section-header {
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		margin-bottom: 1.75rem;
		border-bottom: 1px solid #e4e4e7;
		padding-bottom: 0.6rem;
	}
	.section-header h2 {
		font-size: 1.35rem;
		font-weight: 700;
		color: #09090b;
		margin: 0;
	}
	.all-archive-link {
		font-size: 0.9rem;
		font-weight: 600;
		color: #71717a;
		text-decoration: none;
	}
	.posts-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 2rem;
		list-style: none;
		padding: 0;
		margin: 0;
		width: 100%;
	}
	.post-card {
		background: #ffffff;
		border: 1px solid #f4f4f5;
		border-radius: 8px;
		overflow: hidden;
		width: 100%;
		box-sizing: border-box;
	}
	.card-link {
		text-decoration: none;
		color: inherit;
		display: flex;
		flex-direction: column;
		height: 100%;
	}
	.card-img-wrap {
		width: 100%;
		height: 220px;
		background: #f4f4f5;
		overflow: hidden;
	}
	.card-img-wrap img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.card-body {
		padding: 1.25rem 1.1rem;
		display: flex;
		flex-direction: column;
		flex-grow: 1;
	}
	.card-date {
		font-size: 0.82rem;
		color: #71717a;
		margin-bottom: 0.4rem;
	}
	.card-title {
		font-size: 1.15rem;
		font-weight: 700;
		line-height: 1.4;
		margin: 0 0 0.5rem 0;
		color: #09090b;
	}
	.card-desc {
		font-size: 0.9rem;
		line-height: 1.5;
		color: #52525b;
		margin: 0;
	}

	@media (max-width: 768px) {
		main {
			padding: 1rem 0.75rem 3rem 0.75rem;
		}
		.lead-article {
			margin-bottom: 2rem;
			border-radius: 8px;
		}
		.lead-wrapper {
			grid-template-columns: 1fr;
		}
		.lead-image-box {
			height: 210px;
			min-height: auto;
		}
		.lead-content {
			padding: 1.25rem 1rem;
		}
		.lead-title {
			font-size: 1.35rem;
			line-height: 1.35;
		}
		.lead-description {
			font-size: 0.92rem;
			margin-bottom: 1.2rem;
		}
		.posts-grid {
			grid-template-columns: 1fr;
			gap: 1.5rem;
		}
		.card-img-wrap {
			height: 190px;
		}
	}
</style>
