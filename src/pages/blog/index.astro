---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

function getImageUrl(image) {
	if (!image) return '';
	return typeof image === 'object' && image.src ? image.src : image;
}
---

<!doctype html>
<html lang="tr">
	<head>
		<BaseHead title={`Köşe Yazıları - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="archive-header">
				<h1>Köşe Yazıları Arşivi</h1>
				<p>Turan Özkan'ın güncel ve geçmiş köşe yazıları, analizleri ve makaleleri.</p>
			</section>

			<section class="posts-section">
				<ul class="posts-grid">
					{
						posts.map((post) => (
							<li class="post-card">
								<a href={`/blog/${post.id}/`} class="card-link">
									<div class="card-img-wrap">
										<img 
											src={getImageUrl(post.data.heroImage)} 
											alt={post.data.title} 
										/>
									</div>
									<div class="card-body">
										<div class="card-date">
											<FormattedDate date={post.data.pubDate} />
										</div>
										<h2 class="card-title">{post.data.title}</h2>
										<p class="card-desc">{post.data.description}</p>
									</div>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		max-width: 1040px;
		width: 100%;
		margin: 0 auto;
		padding: 2.5rem 1.25rem 4rem 1.25rem;
		box-sizing: border-box;
	}

	.archive-header {
		margin-bottom: 2.5rem;
		border-bottom: 1px solid #e4e4e7;
		padding-bottom: 1rem;
	}
	.archive-header h1 {
		font-size: 2rem;
		font-weight: 700;
		color: #09090b;
		margin: 0 0 0.5rem 0;
		letter-spacing: -0.02em;
	}
	.archive-header p {
		font-size: 1rem;
		color: #71717a;
		margin: 0;
	}

	.posts-section {
		width: 100%;
	}
	.posts-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 2rem;
		list-style: none;
		padding: 0;
		margin: 0;
		width: 100%;
	}
	.post-card {
		background: #ffffff;
		border: 1px solid #f4f4f5;
		border-radius: 8px;
		overflow: hidden;
		width: 100%;
		box-sizing: border-box;
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}
	.post-card:hover {
		transform: translateY(-3px);
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
	}
	.card-link {
		text-decoration: none;
		color: inherit;
		display: flex;
		flex-direction: column;
		height: 100%;
	}
	.card-img-wrap {
		width: 100%;
		height: 220px;
		background: #f4f4f5;
		overflow: hidden;
	}
	.card-img-wrap img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.3s ease;
	}
	.post-card:hover .card-img-wrap img {
		transform: scale(1.03);
	}
	.card-body {
		padding: 1.25rem 1.1rem;
		display: flex;
		flex-direction: column;
		flex-grow: 1;
	}
	.card-date {
		font-size: 0.82rem;
		color: #71717a;
		margin-bottom: 0.4rem;
	}
	.card-title {
		font-size: 1.15rem;
		font-weight: 700;
		line-height: 1.4;
		margin: 0 0 0.5rem 0;
		color: #09090b;
	}
	.card-desc {
		font-size: 0.9rem;
		line-height: 1.5;
		color: #52525b;
		margin: 0;
	}

	/* Mobil Düzenleme */
	@media (max-width: 768px) {
		main {
			padding: 1.25rem 0.75rem 3rem 0.75rem;
		}
		.archive-header {
			margin-bottom: 1.5rem;
		}
		.archive-header h1 {
			font-size: 1.5rem;
		}
		.archive-header p {
			font-size: 0.9rem;
		}
		.posts-grid {
			grid-template-columns: 1fr;
			gap: 1.5rem;
		}
		.card-img-wrap {
			height: 190px;
		}
	}
</style>
