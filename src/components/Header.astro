<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		margin: 0;
		font-size: 1.15em;
	}
	h2 a,
	h2 a.active {
		text-decoration: none;
		color: rgb(var(--black));
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 960px;
		margin: 0 auto;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--gray-dark);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.internal-links {
		display: flex;
		gap: 0.5rem;
	}
	.social-links {
		display: flex;
		align-items: center;
		gap: 0.6rem;
	}
	.social-links a {
		display: flex;
		align-items: center;
		padding: 0.35em;
		color: rgb(var(--gray));
		border-bottom: none;
		transition: color 0.2s ease;
	}
	.social-links a:hover {
		color: rgb(var(--black));
	}
	.sonsoz-badge {
		font-size: 0.8rem;
		font-weight: 600;
		background: #f1f3f5;
		color: #2b2b2b !important;
		padding: 0.25rem 0.6rem !important;
		border-radius: 4px;
		border: 1px solid #dee2e6;
		transition: all 0.2s ease;
	}
	.sonsoz-badge:hover {
		background: #2b2b2b;
		color: #ffffff !important;
	}
	@media (max-width: 768px) {
		.social-links {
			display: none;
		}
	}
</style>
